{
  "name": "c-cpp-playground",
  "productName": "Playground",
  "version": "1.7.0",
  "private": true,
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@live-codes/java-wasm": "0.1.0",
    "@yowasp/clang": "22.0.0-git20695-13",
    "codemirror": "5.65.16",
    "electron": "45.5.0",
    "electron-builder": "26.18.0",
    "pyodide": "314.0.8",
    "web-tree-sitter": "0.25.10"
  },
  "description": "Write C, C++, Java and Python and see the output as you type. Works offline: the compilers run inside the app.",
  "author": "Mazharul Islam",
  "license": "MIT",
  "homepage": "https://mazhar1807102.github.io/c-cpp-playground/",
  "main": "main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "start": "npm run prepare-web && electron .",
    "dist:win": "npm run prepare-web && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-web && electron-builder --mac --publish never",
    "dist:linux": "npm run prepare-web && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.mazhar1807102.cppplayground",
    "productName": "Playground",
    "copyright": "Copyright © 2026 Mazharul Islam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "web/**/*"
    ],
    "asar": true,
    "artifactName": "Playground-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Playground",
      "artifactName": "Playground-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Playground-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Playground-${version}-Mac.${ext}"
    },
    "dmg": {
      "title": "Playground"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "playground",
      "synopsis": "Write and run C, C++, Java and Python offline",
      "maintainer": "Mazharul Islam <MAZHAR1807102@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "Playground",
          "Keywords": "C;C++;Java;Python;compiler;programming;"
        }
      }
    },
    "deb": {
      "artifactName": "Playground-${version}-Linux-amd64.${ext}"
    },
    "appImage": {
      "artifactName": "Playground-${version}-Linux-x86_64.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
