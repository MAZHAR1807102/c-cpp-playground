{
  "name": "c-cpp-playground",
  "productName": "C and C++ Playground",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@yowasp/clang": "22.0.0-git20695-13",
    "codemirror": "5.65.16",
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "description": "Write C and C++ and see the output as you type. Works offline: Clang runs inside the app.",
  "author": "Mazharul Islam",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "prepare-web": "node scripts/prepare-web.mjs",
    "start": "npm run prepare-web && electron .",
    "dist:win": "npm run prepare-web && electron-builder --win --publish never",
    "dist:mac": "npm run prepare-web && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "io.github.mazhar1807102.cppplayground",
    "productName": "C and C++ Playground",
    "copyright": "Copyright © 2026 Mazharul Islam",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "web/**/*"
    ],
    "asar": true,
    "artifactName": "CPP-Playground-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "C and C++ Playground",
      "artifactName": "CPP-Playground-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "CPP-Playground-${version}-Windows-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "CPP-Playground-${version}-Mac.${ext}"
    },
    "dmg": {
      "title": "C and C++ Playground"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
